# Copia este archivo a .env.local y rellena los valores.
#   cp .env.example .env.local
#
# La app corre contra el proyecto de Supabase en la nube (no hay base local).
# Valores en: Dashboard → Project Settings → API Keys / Data API.

# ── Supabase (obligatorias) ─────────────────────────────────────────────────
# URL del proyecto: https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...) o la anon key legacy. Es pública: toda
# la seguridad la pone el RLS de la base, no esta clave.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── Sitio ───────────────────────────────────────────────────────────────────
# Dominio canónico, sin barra final. Lo usan metadataBase, sitemap.xml,
# robots.txt y las imágenes OG. En producción ponlo siempre: sin él se cae a
# VERCEL_URL, que es la URL del deployment, no la del dominio.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Opcional. Token de verificación de Google Search Console (método "etiqueta
# HTML": solo el valor de content="..."). Si está, sale como meta tag.
GOOGLE_SITE_VERIFICATION=

# ── Tests de base de datos (opcional, solo para `pnpm test:db`) ─────────────
# Connection string de Postgres (Dashboard → Connect → Session pooler).
# Contiene la contraseña de la base: nunca la subas al repo. Los tests corren
# en una transacción que se deshace, pero úsala contra un proyecto de
# desarrollo, no contra producción.
SUPABASE_DB_URL=
